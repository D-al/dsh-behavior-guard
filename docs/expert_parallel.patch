+// LOCAL PATCH 2026-11-23: expert-parallel dispatch for MoE decode.
+// Stock: 8 threads split the output rows of ONE expert, experts are processed serially.
+// This:  each thread takes a different active expert, so the 8 weight reads overlap and
+//        hide DDR latency. Controlled by env GGML_MMID_EXPERT_PARALLEL=1 (default off).
+static bool ggml_mmid_expert_parallel(void) {
+    static int checked = 0;
+    static int enabled = 0;
+    if (!checked) {
+        const char * env = getenv("GGML_MMID_EXPERT_PARALLEL");
+        enabled = (env != NULL && atoi(env) == 1) ? 1 : 0;
+        checked = 1;
+    }
+    return enabled != 0;
+}
